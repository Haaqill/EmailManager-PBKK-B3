// app/Providers/AppServiceProvider.php — dua tempelan:

// (1) Di BAGIAN ATAS file, di bawah `namespace App\Providers;`:
use App\Models\BatchPlanItem;
use App\Models\ChatMessage;
use App\Models\User;
use Illuminate\Database\Eloquent\Relations\Relation;

// (2) Di DALAM method boot() yang SUDAH ADA (jangan membuat boot() kedua):
        // Alias stabil untuk kolom loggable_type (bukan nama kelas PHP).
        // enforceMorphMap menolak model morph yang tidak terdaftar, jadi User ikut
        // didaftarkan (dipakai notifikasi database, token Sanctum, Spatie Permission).
        Relation::enforceMorphMap([
            'user' => User::class,
            'chat_message' => ChatMessage::class,
            'batch_plan_item' => BatchPlanItem::class,
        ]);
