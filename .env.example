# Backend LLM: mock | campus
LLM_BACKEND=mock

# Gaya API: openai | ollama (ditentukan oleh smoke test)
LLM_API_STYLE=openai

# Mode tool calling: native | json (ditentukan oleh smoke test)
LLM_TOOL_MODE=json

# Endpoint LLM kampus 
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Path dataset (default sudah benar, ubah hanya jika perlu)
EVAL_DATASET_PATH=eval/dataset.json
