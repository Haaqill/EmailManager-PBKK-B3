# Backend LLM: mock | campus
LLM_BACKEND=mock

# Gaya API: openai | ollama (hasil smoke test openai)
LLM_API_STYLE=openai

# Mode tool calling: native | json (hasil smoke test: native)
LLM_TOOL_MODE=native

# Endpoint LLM kampus "Senopati" (api key masing2, wajib jika LLM_BACKEND=campus)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Timeout per permintaan LLM (detik)
LLM_TIMEOUT_S=120

# Path dataset (default sudah benar, ubah hanya jika perlu)
EVAL_DATASET_PATH=eval/dataset.json
