// app/Models/User.php (model bawaan Breeze) — dua tempelan:

// (1) Di BAGIAN ATAS file, di bawah `namespace App\Models;` bersama use lainnya:
use Illuminate\Database\Eloquent\Relations\HasMany;

// (2) Di DALAM class User:
    // User memiliki banyak ChatSession
    public function chatSessions(): HasMany
    {
        return $this->hasMany(ChatSession::class);
    }
